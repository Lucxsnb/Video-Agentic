{
  "title": "Phase 3 props, camera, lighting test",
  "style_preset": "dark_miniseries",
  "characters": [
    {"id": "courier", "library": "delivery_guy"},
    {"id": "manager", "library": "store_manager"},
    {"id": "clerk", "library": "store_clerk"}
  ],
  "scenes": [
    {
      "id": "aisle",
      "background": "supermarket_aisle",
      "shots": [
        {"camera": {"type": "zoom_in", "from": 1.0, "to": 1.7, "target": "courier.chest", "target_to": "phone1"},
         "actors": [{"id": "courier", "x": 0.5, "y": 0.86, "pose": "hold", "expression": "worried"}],
         "props": [{"svg": "phone_incoming_call", "id": "phone1", "attach_to": "courier.hand_r", "scale": 1.1,
                    "anim": "ring", "params": {"name": "Mom"}},
                   {"svg": "sack", "x": 0.12, "y": 0.9, "layer": "back"},
                   {"svg": "sack", "x": 0.22, "y": 0.92, "layer": "back", "params": {"label": "BEANS", "color": "#3B6EA5"}}],
         "line": {"text": "His phone rings. It's his mom.", "highlight": ["mom"]},
         "transition_out": "whip"}
      ]
    },
    {
      "id": "storage",
      "background": "storage_room",
      "shots": [
        {"camera": {"type": "static", "from": 1.8, "target": "manager.head", "punch": 0.7},
         "actors": [{"id": "courier", "x": 0.38, "y": 0.9, "pose": "idle", "expression": "nervous", "facing": "left"},
                    {"id": "manager", "x": 0.66, "y": 0.84, "pose": "hold_up", "expression": "suspicious", "facing": "left"}],
         "props": [{"svg": "hammer", "attach_to": "manager.hand_r", "rotation": -20}],
         "line": {"speaker": "manager", "text": "Just in case.", "highlight": ["case"]},
         "transition_out": "flash"},
        {"camera": {"type": "pan_right", "from": 1.12, "pan": 0.1},
         "lighting": {"darkness": 0.78, "lights": [{"type": "cone", "source": "flashlight1.tip", "radius": 0.6, "spread": 36, "flicker": 0.15}]},
         "actors": [{"id": "clerk", "x": 0.2, "y": 0.86, "pose": "point", "expression": "scared", "facing": "right"}],
         "props": [{"svg": "flashlight", "id": "flashlight1", "attach_to": "clerk.hand_r", "rotation": -14},
                   {"svg": "cardboard_box", "x": 0.8, "y": 0.72, "layer": "back", "scale": 1.3}],
         "line": {"speaker": "clerk", "text": "Something is moving in here.", "highlight": ["moving"]},
         "transition_out": "fade"}
      ]
    },
    {
      "id": "alley",
      "background": "back_alley",
      "lighting": {"darkness": 0.5, "lights": [{"type": "spot", "x": 0.69, "y": 0.3, "radius": 0.5}]},
      "shots": [
        {"camera": {"type": "zoom_in", "from": 1.4, "to": 1.6, "target": "sign1", "frame_y": 0.4},
         "actors": [{"id": "manager", "x": 0.5, "y": 0.88, "pose": "hold_both", "expression": "nervous"}],
         "props": [{"svg": "cardboard_sign", "id": "sign1", "attach_to": "manager.chest", "dy": 0.07, "scale": 1.25,
                    "params": {"text": "Hi mom, everything is going according to plan. Don't come in."}}],
         "caption_y": 0.84,
         "line": {"speaker": "courier", "text": "Hi mom. Everything is going according to plan.", "highlight": ["plan"]}}
      ]
    }
  ]
}
